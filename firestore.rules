rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every agent can read and write only their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Customer self-service links. Anyone holding the exact (random) link can read that one
    // document; nobody can list them. Only the agent who created a link can change or delete it.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
